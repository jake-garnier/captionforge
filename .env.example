# Copy to .env and fill in the values you need. Everything not listed here has
# a sensible default in config/settings.py.

# Application Configuration
ENVIRONMENT=production
DEBUG=false

# Playwright Configuration (browser-based scraping/posting, no Reddit API key needed)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# PostgreSQL Database
POSTGRES_DB=captions
POSTGRES_USER=captionsuser
POSTGRES_PASSWORD=change_this_secure_password

# Redis (optional password)
REDIS_PASSWORD=

# Scraping Configuration
SCRAPING_ENABLED=true
SCRAPING_INTERVAL_HOURS=6
MAX_POSTS_PER_SCRAPE=100
DOWNLOAD_MAX_FILE_SIZE_MB=100
DOWNLOAD_MAX_DURATION_SECONDS=600

# Proxy pool (comma-separated, user:pass@host:port). Each subreddit gets a
# dedicated proxy. Alternatively drop one proxy per line into proxy_list.txt.
PROXY_POOL=

# Flower Dashboard (optional basic auth - format: username:password)
FLOWER_BASIC_AUTH=admin:changeme

# LLM Post-Processing (llama-server on the host machine)
LLM_POSTPROCESS_ENABLED=true
LLM_QUALITY_THRESHOLD=0.6  # Only use LLM if caption quality score < this (0-1)

# Host-machine access from inside containers (llama-server control via SSH).
# LLM_HOST_IP is the address containers use to reach the host; the default
# works with the extra_hosts entry in docker-compose.yml.
LLM_HOST_IP=host.docker.internal
LLM_HOST_SSH_USER=ubuntu
# Prefer a key; the password is only used when no key path is set.
LLM_HOST_SSH_KEY_PATH=
LLM_HOST_SSH_PASSWORD=

# Public base URL of this API. Composed videos are served from here so Reddit
# link posts and Postpone schedules can point at them (see publishers/media_host.py).
# e.g. https://captions.example.com (Cloudflare tunnel) or http://<vm-ip>:8000
MEDIA_BASE_URL=https://captions.example.com
# Media host implementation: "self" serves videos from this API (default).
MEDIA_HOST_TYPE=self

# Public noVNC URL shown in the UI for interactive browser logins (Reddit, Patreon)
NOVNC_PUBLIC_URL=http://localhost:6080/vnc.html?autoconnect=true

# Reddit Posting Configuration
# REDDIT_POSTER_TYPE: "playwright" (browser, no API key) or "praw" (API, requires credentials)
REDDIT_POSTER_TYPE=playwright
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
# Only needed if REDDIT_POSTER_TYPE=praw:
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret

# Postpone API Configuration (Scheduled Reddit Posting)
# Sign up at https://postpone.app (paid plan required for API access)
# Get API key from Settings > Integrations > Postpone API
POSTPONE_API_KEY=

# Telegram scraping (Telethon user account for channel scraping)
# Get credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Vast.ai (cloud LoRA training on rented GPUs)
# Get API key from https://vast.ai/console/account/
VASTAI_API_KEY=

# Cloudflare Tunnel (Public Access)
# Create tunnel at https://one.dash.cloudflare.com -> Networks -> Tunnels
# Route: captions.example.com -> http://api:8000
CLOUDFLARE_TUNNEL_TOKEN=

# Patreon API (Creator OAuth Client)
# Create client at https://www.patreon.com/portal/registration/register-clients
# Tokens shown on the client detail page after creation. Used for:
#   - Reading active patron list (membership truth)
#   - Reading post comments via Playwright (no API for comments)
# Per-niche: each niche that runs the Patreon->Telegram sync gets its own client.
PATREON_MOTIVATION_CLIENT_ID=
PATREON_MOTIVATION_CLIENT_SECRET=
PATREON_MOTIVATION_ACCESS_TOKEN=
PATREON_MOTIVATION_REFRESH_TOKEN=
# Campaign ID is fetched once via /api/oauth2/v2/identity?include=campaign and cached
PATREON_MOTIVATION_CAMPAIGN_ID=
# The single Patreon post whose comments we scrape for Telegram usernames
PATREON_MOTIVATION_POST_ID=
